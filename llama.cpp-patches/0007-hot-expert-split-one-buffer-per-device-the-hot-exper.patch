From f7cc6144191c95f20253066115d107a42f546ec2 Mon Sep 17 00:00:00 2001
From: shi3z <shi3z@me.com>
Date: Fri, 16 Oct 2026 13:42:07 +0000
Subject: [PATCH 07/12] hot-expert split: one buffer per device (the hot
 experts of a layer live on the device that runs the layer)

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/llama-model.cpp | 75 ++++++++++++++++++++++++++-------------------
 src/llama-model.h   |  4 +--
 2 files changed, 45 insertions(+), 34 deletions(-)

diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 9b3da0965..47aeddf46 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -2095,42 +2095,53 @@ void llama_model_base::load_tensors_moe_hot(llama_model_loader & ml) {
         return;
     }
 
-    ggml_init_params params = {
-        /*.mem_size   =*/ ggml_tensor_overhead() * plans.size() * 7,
-        /*.mem_buffer =*/ NULL,
-        /*.no_alloc   =*/ true,
-    };
-    moe_hot.ctx.reset(ggml_init(params));
     moe_hot.layers.assign(n_layer, llama_moe_hot_layer());
 
-    ggml_context * ctx = moe_hot.ctx.get();
+    // one context + buffer per device: the hot experts of a layer live on the device that runs the layer
+    std::map<ggml_backend_buffer_type_t, std::vector<const plan_t *>> by_buft;
     for (const auto & pl : plans) {
-        const auto & layer = layers[pl.il];
-        auto & h = moe_hot.layers[pl.il];
-        h.n_hot = (int32_t) pl.experts.size();
-        auto mk = [&](ggml_tensor * src, const char * suffix) {
-            ggml_tensor * t = ggml_new_tensor_3d(ctx, src->type, src->ne[0], src->ne[1], h.n_hot);
-            ggml_format_name(t, "%s.hot%s", ggml_get_name(src), suffix);
-            return t;
-        };
-        h.up   = mk(layer.ffn_up_exps,   "");
-        h.gate = mk(layer.ffn_gate_exps, "");
-        h.down = mk(layer.ffn_down_exps, "");
-        h.hot_idx  = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, n_expert);
-        h.cold_idx = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, n_expert);
-        h.mask     = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1, n_expert);
-        h.cold_mask = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1, n_expert);
-        ggml_format_name(h.cold_mask, "blk.%d.moe_cold_mask", pl.il);
-        ggml_format_name(h.hot_idx,  "blk.%d.moe_hot_idx",  pl.il);
-        ggml_format_name(h.cold_idx, "blk.%d.moe_cold_idx", pl.il);
-        ggml_format_name(h.mask,     "blk.%d.moe_hot_mask", pl.il);
+        by_buft[pl.buft].push_back(&pl);
     }
-    // one device for now (all qualifying layers share the first plan's buffer type)
-    moe_hot.buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(ctx, plans[0].buft));
-    if (!moe_hot.buf) {
-        throw std::runtime_error("hot-expert split: failed to allocate the GPU buffer");
+    for (auto & [buft, group] : by_buft) {
+        ggml_init_params params = {
+            /*.mem_size   =*/ ggml_tensor_overhead() * group.size() * 7,
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        ggml_context * ctx = ggml_init(params);
+        moe_hot.ctxs.emplace_back(ctx);
+        size_t group_bytes = 0;
+        for (const plan_t * plp : group) {
+            const auto & pl = *plp;
+            const auto & layer = layers[pl.il];
+            auto & h = moe_hot.layers[pl.il];
+            h.n_hot = (int32_t) pl.experts.size();
+            auto mk = [&](ggml_tensor * src, const char * suffix) {
+                ggml_tensor * t = ggml_new_tensor_3d(ctx, src->type, src->ne[0], src->ne[1], h.n_hot);
+                ggml_format_name(t, "%s.hot%s", ggml_get_name(src), suffix);
+                group_bytes += ggml_nbytes(t);
+                return t;
+            };
+            h.up   = mk(layer.ffn_up_exps,   "");
+            h.gate = mk(layer.ffn_gate_exps, "");
+            h.down = mk(layer.ffn_down_exps, "");
+            h.hot_idx  = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, n_expert);
+            h.cold_idx = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, n_expert);
+            h.mask     = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1, n_expert);
+            h.cold_mask = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1, n_expert);
+            ggml_format_name(h.hot_idx,   "blk.%d.moe_hot_idx",   pl.il);
+            ggml_format_name(h.cold_idx,  "blk.%d.moe_cold_idx",  pl.il);
+            ggml_format_name(h.mask,      "blk.%d.moe_hot_mask",  pl.il);
+            ggml_format_name(h.cold_mask, "blk.%d.moe_cold_mask", pl.il);
+        }
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, buft);
+        if (!buf) {
+            throw std::runtime_error(format("hot-expert split: failed to allocate %.2f GiB on %s", group_bytes / 1024.0 / 1024.0 / 1024.0, ggml_backend_buft_name(buft)));
+        }
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        moe_hot.bufs.emplace_back(buf);
+        LLAMA_LOG_WARN("%s: %zu layers, %.2f GiB of hot experts on %s\n", __func__, group.size(), group_bytes / 1024.0 / 1024.0 / 1024.0, ggml_backend_buft_name(buft));
     }
-    ggml_backend_buffer_set_usage(moe_hot.buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
 
     size_t n_bytes = 0;
     std::vector<no_init<uint8_t>> staging;
@@ -2171,7 +2182,7 @@ void llama_model_base::load_tensors_moe_hot(llama_model_loader & ml) {
         ggml_backend_tensor_set(h.mask,     mask.data(),     0, mask.size()     * sizeof(float));
         LLAMA_LOG_INFO("%s: layer %3d: %d hot experts on %s\n", __func__, pl.il, h.n_hot, ggml_backend_buft_name(pl.buft));
     }
-    LLAMA_LOG_INFO("%s: %zu layers, %.2f GiB of hot experts uploaded\n", __func__, plans.size(), n_bytes / 1024.0 / 1024.0 / 1024.0);
+    LLAMA_LOG_WARN("%s: %zu layers, %.2f GiB of hot experts uploaded\n", __func__, plans.size(), n_bytes / 1024.0 / 1024.0 / 1024.0);
 }
 
 // read and check the prism.hadamard metadata, and record the folded weights (load_tensors_hadamard makes the tensors)
diff --git a/src/llama-model.h b/src/llama-model.h
index 03d3f5aef..b093c1d0c 100644
--- a/src/llama-model.h
+++ b/src/llama-model.h
@@ -718,8 +718,8 @@ struct llama_moe_hot_layer {
 
 struct llama_moe_hot {
     std::vector<llama_moe_hot_layer> layers; // indexed by layer, empty when disabled
-    ggml_context_ptr        ctx;
-    ggml_backend_buffer_ptr buf;
+    std::vector<ggml_context_ptr>        ctxs; // one context + buffer per device
+    std::vector<ggml_backend_buffer_ptr> bufs;
 };
 
 struct llama_model {
-- 
2.34.1

