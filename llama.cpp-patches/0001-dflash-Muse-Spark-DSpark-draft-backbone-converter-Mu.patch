+        }
+    }
     cb(inpL, "inp_noise_embd", -1);
 
     for (int il = 0; il < n_layer; ++il) {
@@ -984,10 +1003,26 @@ llama_model_dflash::graph<false>::graph(const llama_model & model, const llm_gra
         cb(Kcur, "Kcur", il);
         cb(Vcur, "Vcur", il);
 
+        const bool muse = layer.wqkv_gate != nullptr;   // Muse Spark backbone: gated, normed attention output + residual gates
+
         // cache-aware, non-causal attention
         ggml_tensor * cur = use_iswa
-            ? build_attn(inp_attn_iswa, layer.wo, NULL, layer.wo_s, Qcur, Kcur, Vcur, nullptr, layer.attn_sinks, nullptr, kq_scale, il)
-            : build_attn(inp_attn,      layer.wo, NULL, layer.wo_s, Qcur, Kcur, Vcur, nullptr, layer.attn_sinks, nullptr, kq_scale, il);
+            ? build_attn(inp_attn_iswa, muse ? NULL : layer.wo, NULL, muse ? NULL : layer.wo_s, Qcur, Kcur, Vcur, nullptr, layer.attn_sinks, nullptr, kq_scale, il)
+            : build_attn(inp_attn,      muse ? NULL : layer.wo, NULL, muse ? NULL : layer.wo_s, Qcur, Kcur, Vcur, nullptr, layer.attn_sinks, nullptr, kq_scale, il);
+
+        if (muse) {
+            // weightless per-head RMS norm of the attention output, sigmoid gate from the normed input, then o_proj
+            cur = ggml_reshape_3d(ctx0, cur, n_embd_head, n_head, n_tokens);
+            cur = ggml_rms_norm(ctx0, cur, hparams.f_norm_rms_eps);
+            cur = ggml_reshape_2d(ctx0, cur, n_embd_head * n_head, n_tokens);
+            ggml_tensor * gate = build_lora_mm(layer.wqkv_gate, noise_norm, layer.wqkv_gate_s);
+            cur = ggml_mul(ctx0, cur, ggml_sigmoid(ctx0, gate));
+            cb(cur, "attn_gated", il);
+            cur = build_lora_mm(layer.wo, cur, layer.wo_s);
+            // weightless post-attention norm, then the norm-preserving residual gate
+            cur = ggml_rms_norm(ctx0, cur, hparams.f_post_norm_eps);
+            cb(cur, "attn_post_norm", il);
+        }
 
         if (hparams.f_attn_value_scale != 0.0f) {
             cur = ggml_scale(ctx0, cur, hparams.f_attn_value_scale);
@@ -1004,7 +1039,9 @@ llama_model_dflash::graph<false>::graph(const llama_model & model, const llm_gra
