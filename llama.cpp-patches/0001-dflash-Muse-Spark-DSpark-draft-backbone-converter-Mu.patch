@@ -310,6 +313,15 @@ void llama_model_dflash::load_arch_tensors(llama_model_loader &) {
 
         layer.attn_post_norm = create_tensor(tn(LLM_TENSOR_ATTN_POST_NORM, "weight", i), { n_embd }, TENSOR_NOT_REQUIRED);
         layer.ffn_post_norm  = create_tensor(tn(LLM_TENSOR_FFN_POST_NORM,  "weight", i), { n_embd }, TENSOR_NOT_REQUIRED);
+        // Muse Spark backbone (optional): attention output gate, norm-preserving residual gates
+        layer.wqkv_gate        = create_tensor(tn(LLM_TENSOR_ATTN_GATE,        "weight", i), { n_embd, n_embd_head_k * n_head }, TENSOR_NOT_REQUIRED);
+        layer.attn_resid_alpha = create_tensor(tn(LLM_TENSOR_ATTN_RESID_ALPHA, "weight", i), { n_embd }, TENSOR_NOT_REQUIRED);
+        layer.attn_resid_beta  = create_tensor(tn(LLM_TENSOR_ATTN_RESID_BETA,  "weight", i), { n_embd }, TENSOR_NOT_REQUIRED);
+        layer.ffn_resid_alpha  = create_tensor(tn(LLM_TENSOR_FFN_RESID_ALPHA,  "weight", i), { n_embd }, TENSOR_NOT_REQUIRED);
+        layer.ffn_resid_beta   = create_tensor(tn(LLM_TENSOR_FFN_RESID_BETA,   "weight", i), { n_embd }, TENSOR_NOT_REQUIRED);
+        if (layer.wqkv_gate && !(layer.attn_resid_alpha && layer.attn_resid_beta && layer.ffn_resid_alpha && layer.ffn_resid_beta && layer.ffn_post_norm)) {
+            throw std::runtime_error("Muse Spark DFlash backbone requires residual gates and ffn_post_norm");
+        }
         layer.out_scale      = create_tensor(tn(LLM_TENSOR_LAYER_OUT_SCALE, "weight", i), { 1 }, TENSOR_NOT_REQUIRED);
         layer.rope_freqs     = create_tensor(tn(LLM_TENSOR_ROPE_FREQS, "weight", i), { n_embd_head_k/2 }, TENSOR_NOT_REQUIRED | (i > 0 ? TENSOR_DUPLICATED : 0));
 
@@ -948,6 +960,13 @@ llama_model_dflash::graph<false>::graph(const llama_model & model, const llm_gra
     if (hparams.f_embedding_scale != 0.0f) {
         inpL = ggml_scale(ctx0, inpL, hparams.f_embedding_scale);
     }
+    if (model.layers[0].wqkv_gate != nullptr) {
+        // Muse Spark backbone: the target norms its token embeddings (weightless RMS); LLAMA_DFLASH_MUSE_EMBD_NORM=0 disables
+        static const bool embd_norm = [] { const char * e = getenv("LLAMA_DFLASH_MUSE_EMBD_NORM"); return e == nullptr || atoi(e) != 0; }();
+        if (embd_norm) {
