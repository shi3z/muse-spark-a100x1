From 36f857681c804998f7d74fe35cf2219170542ef5 Mon Sep 17 00:00:00 2001
From: shi3z <shi3z@me.com>
Date: Fri, 16 Oct 2026 22:28:39 +0000
Subject: [PATCH 09/11] hot-expert split: drop the cold-side mask (the host
 kernel already zeroes skipped rows), combine on the device

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/llama-graph.cpp | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index fef317ad8..3136d5f46 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -2495,9 +2495,10 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
 
         ggml_tensor * experts_cold = run_experts(up_exps,  gate_exps,  down_exps,  nullptr, ids_cold, nullptr);
         ggml_tensor * experts_hot  = run_experts(hot->up,  hot->gate,  hot->down,  nullptr, ids_hot,  nullptr);
-        experts_hot  = ggml_mul(ctx0, experts_hot,  mask);  // cold slots were pointed at hot slot 0: zero them
-        experts_cold = ggml_mul(ctx0, experts_cold, cmask); // hot slots were pointed at expert 0: zero them
-        experts = ggml_add(ctx0, experts_cold, experts_hot);
+        experts_hot = ggml_mul(ctx0, experts_hot, mask);   // cold slots were pointed at hot slot 0: zero them
+        // the host kernel zeroes the rows of the skipped (hot) slots, so experts_cold needs no mask
+        experts = ggml_add(ctx0, experts_hot, experts_cold); // src0 on the device: the add and what follows stay on the GPU
+        GGML_UNUSED(cmask);
         cb(experts, "ffn_moe_down_split", il);
     } else {
         experts = run_experts(up_exps, gate_exps, down_exps, gate_up_exps, selected_experts, slots);
-- 
