+// moe-routing-stats: run a prompt through the model and histogram which experts each MoE layer selects.
+// Output (stdout, CSV): layer,expert,count  -- plus a per-layer summary on stderr.
+// Usage: llama-moe-routing-stats -m model.gguf -f prompt.txt [-ngl 99 --n-cpu-moe 62 ...] > routing.csv
+#include "arg.h"
+#include "common.h"
+#include "log.h"
+#include "llama.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <clocale>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <string>
+#include <vector>
+
+struct routing_stats {
+    std::map<int, std::vector<uint64_t>> counts; // layer -> per-expert selection count
+    uint64_t n_tokens_seen = 0;
+};
+
+static bool cb_eval(struct ggml_tensor * t, bool ask, void * user_data) {
+    auto * st = (routing_stats *) user_data;
+    const char * name = ggml_get_name(t);
+    const bool is_topk = strncmp(name, "ffn_moe_topk-", 13) == 0;
+    if (ask) {
+        return is_topk;
+    }
+    if (!is_topk || t->type != GGML_TYPE_I32) {
+        return true;
+    }
+    const int il = atoi(name + 13);
+    const int64_t n_used = t->ne[0];
+    const int64_t n_tok  = t->ne[1];
+    // ggml_argsort_top_k returns a strided view into the full argsort: honour nb[0]/nb[1]
+    std::vector<uint8_t> buf(ggml_nbytes(t));
+    ggml_backend_tensor_get(t, buf.data(), 0, buf.size());
+    auto & c = st->counts[il];
+    for (int64_t i1 = 0; i1 < n_tok; ++i1) {
+        for (int64_t i0 = 0; i0 < n_used; ++i0) {
+            const int32_t id = *(const int32_t *) (buf.data() + i1*t->nb[1] + i0*t->nb[0]);
+            if (id < 0) continue;
+            if ((size_t) id >= c.size()) c.resize(id + 1, 0);
+            c[id]++;
+        }
+    }
+    if (il == 0 || st->counts.size() == 1) st->n_tokens_seen += n_tok;
+    return true;
+}
+
+int main(int argc, char ** argv) {
+    std::setlocale(LC_NUMERIC, "C");
+    routing_stats st;
+    common_params params;
+    common_init();
+    if (!common_params_parse(argc, argv, params, LLAMA_EXAMPLE_COMMON)) {
+        return 1;
+    }
+    llama_backend_init();
+    llama_numa_init(params.numa);
+    params.cb_eval = cb_eval;
+    params.cb_eval_user_data = &st;
+    params.warmup = false;
+
+    auto llama_init = common_init_from_params(params);
+    auto * model = llama_init->model();
+    auto * ctx   = llama_init->context();
+    if (model == nullptr || ctx == nullptr) {
+        LOG_ERR("%s : failed to init\n", __func__);
+        return 1;
+    }
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+    std::vector<llama_token> tokens = common_tokenize(ctx, params.prompt, llama_vocab_get_add_bos(vocab), true);
+    if (tokens.empty()) {
+        LOG_ERR("no input tokens\n");
+        return 1;
+    }
+    LOG_INF("number of input tokens = %zu\n", tokens.size());
+    // feed the prompt in n_batch chunks
+    const int n_batch = params.n_batch;
+    for (size_t i = 0; i < tokens.size(); i += n_batch) {
+        const size_t n = std::min((size_t) n_batch, tokens.size() - i);
+        std::vector<llama_token> chunk(tokens.begin() + i, tokens.begin() + i + n);
+        common_batch batch = common_batch_get_one(ctx, chunk);
+        if (llama_process(ctx, LLAMA_PROCESS_TYPE_DECODE, batch.get())) {
+            LOG_ERR("decode failed at token %zu\n", i);
+            return 1;
+        }
+        LOG_INF("processed %zu / %zu tokens\n", i + n, tokens.size());
+    }
+
+    printf("layer,expert,count\n");
+    for (const auto & [il, c] : st.counts) {
+        uint64_t total = 0;
+        for (auto v : c) total += v;
+        std::vector<uint64_t> sorted(c);
+        std::sort(sorted.rbegin(), sorted.rend());
+        auto share = [&](size_t k) { uint64_t s = 0; for (size_t i = 0; i < k && i < sorted.size(); ++i) s += sorted[i]; return 100.0 * s / std::max<uint64_t>(total, 1); };
+        fprintf(stderr, "layer %3d: %zu experts, %llu selections, share of top-16 %.1f%%, top-32 %.1f%%, top-64 %.1f%%, top-128 %.1f%%\n",
+                il, c.size(), (unsigned long long) total, share(16), share(32), share(64), share(128));
+        for (size_t e = 0; e < c.size(); ++e) {
+            printf("%d,%zu,%llu\n", il, e, (unsigned long long) c[e]);
+        }
+    }
+    llama_backend_free();
+    return 0;
+}
