+@ModelBase.register("MuseSparkDSparkModel")
+@ModelBase.example("Inferact/Muse-Spark-Open-DSpark")
+class MuseSparkDSparkModel(DSparkModel):
+    """DSpark draft with a Muse Spark backbone (5 dense Muse decoder layers, conditioned on the target's hidden
+    states at target_layer_ids through fc + hidden_norm; Markov + confidence heads). Exported as the DFLASH arch;
+    the C++ side recognizes the Muse backbone by the attention gate / residual gate tensors."""
+    model_arch = gguf.MODEL_ARCH.DFLASH
+
+    # the draft config carries no MetaP scalars: these are the Muse Spark text defaults (transformers)
+    QK_SCALE_FACTOR = 5.4730064863875
+    OUTPUT_MULTIPLIER = 0.1767766952966369
+    RESIDUAL_GATE_TEMPERATURE = 0.3
+
+    def __init__(self, dir_model, *args, **kwargs):
+        hparams = kwargs.pop("hparams", None)
+        if hparams is None:
+            hparams = ModelBase.load_hparams(dir_model, False)
+        # the DFlash base reads rope settings through rope_parameters
+        hparams = {**hparams, "rope_parameters": hparams.get("rope_parameters") or {"rope_type": "default", "rope_theta": hparams["rope_theta"]},
+                   "rope_is_neox_style": True, "use_sliding_window": True}
+        super().__init__(dir_model, *args, hparams=hparams, **kwargs)
+        if self.hparams.get("markov_head_type", "vanilla") != "vanilla":
+            raise ValueError("Muse DSpark: only the vanilla Markov head is supported")
+        if (self.hparams.get("draft_vocab_size") or self.hparams["vocab_size"]) != self.hparams["vocab_size"]:
+            raise ValueError("Muse DSpark: a full draft vocabulary is required")
+
+    def set_gguf_parameters(self):
+        super().set_gguf_parameters()
+        hp = self.hparams
+        self.gguf_writer.add_head_count(hp["num_attention_heads"])
+        self.gguf_writer.add_head_count_kv(hp["num_key_value_heads"])
+        self.gguf_writer.add_key_length(hp["head_dim"])
+        self.gguf_writer.add_value_length(hp["head_dim"])
+        self.gguf_writer.add_rope_dimension_count(hp["head_dim"])
+        self.gguf_writer.add_rope_freq_base(hp["rope_theta"])
+        self.gguf_writer.add_layer_norm_rms_eps(hp["rms_norm_eps"])
+        self.gguf_writer.add_post_norm_eps(hp.get("rms_post_norm_eps", 1e-8))
+        self.gguf_writer.add_hidden_act("silu")
+        self.gguf_writer.add_logit_scale(hp.get("output_multiplier", self.OUTPUT_MULTIPLIER))
+        self.gguf_writer.add_final_logit_softcapping(hp.get("output_soft_cap_temp", 20.0))
+        # all draft stages are sliding-window layers
+        self.gguf_writer.add_sliding_window(hp["sliding_window"])
+        self.gguf_writer.add_sliding_window_pattern([t == "sliding_attention" for t in hp["layer_types"]])
+
+    @classmethod
+    def filter_tensors(cls, item):
+        name, gen = item
+        if name == "t2d":
+            return None
+        if not name.startswith("model."):
+            name = "model." + name
+        return (name, gen)
+
+    def modify_tensors(self, data_torch, name, bid):
+        if name == "model.d2t":
+            self._d2t = data_torch
+            return
+        if name.endswith("lm_head.weight"):
+            return  # full vocabulary: the frozen target head is shared at runtime
+        # delta norms (stored around zero, effective gain 1 + w)
+        if name.endswith((".pre_qkv_proj_norm.weight", ".pre_ffn_norm.weight", ".post_ffn_norm.weight", "model.hidden_norm.weight", "model.norm.weight")):
+            data_torch = data_torch.float() + 1.0
+        if name.endswith(".self_attn.pre_qkv_proj_norm.weight"):
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.ATTN_NORM, bid), data_torch
+            return
+        if name.endswith(".self_attn.q_proj.weight"):
+            # HF rotate_half layout is kept: the DFLASH arch ropes NeoX-style
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.ATTN_Q, bid), data_torch
+            head_dim = self.hparams["head_dim"]
+            ones = torch.ones(head_dim, dtype=torch.float32)
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.ATTN_Q_NORM, bid), ones * self.hparams.get("qk_scale_factor", self.QK_SCALE_FACTOR)
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.ATTN_K_NORM, bid), ones
+            return
+        if name.endswith(".self_attn.o_gate_proj.weight"):
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.ATTN_GATE, bid), data_torch
+            return
+        if name.endswith((".add_attn.gate", ".add_ffn.gate")):
+            attn = ".add_attn." in name
+            w = data_torch.float() / self.hparams.get("residual_gate_temperature", self.RESIDUAL_GATE_TEMPERATURE)
+            beta = torch.sigmoid(w)
+            alpha = torch.sqrt(torch.clamp(torch.sigmoid(-w) * (1.0 + beta), min=RESIDUAL_GATE_EPS))
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.ATTN_RESID_ALPHA if attn else gguf.MODEL_TENSOR.FFN_RESID_ALPHA, bid), alpha
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.ATTN_RESID_BETA if attn else gguf.MODEL_TENSOR.FFN_RESID_BETA, bid), beta
+            return
+        if name.endswith(".pre_ffn_norm.weight"):
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.FFN_NORM, bid), data_torch
+            return
+        if name.endswith(".post_ffn_norm.weight"):
+            yield self.format_tensor_name(gguf.MODEL_TENSOR.FFN_POST_NORM, bid), data_torch
+            return
+        if ".feed_forward." in name:
+            key = {"gate_proj": gguf.MODEL_TENSOR.FFN_GATE, "up_proj": gguf.MODEL_TENSOR.FFN_UP, "down_proj": gguf.MODEL_TENSOR.FFN_DOWN}[name.split(".feed_forward.")[1].split(".")[0]]
+            yield self.format_tensor_name(key, bid), data_torch
+            return
+        yield from super().modify_tensors(data_torch, name, bid)
