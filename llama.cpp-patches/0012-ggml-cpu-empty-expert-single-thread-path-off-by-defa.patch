From 473fa5ba0c973c3d055c6b12d11401ec048c2054 Mon Sep 17 00:00:00 2001
From: shi3z <shi3z@me.com>
Date: Fri, 16 Oct 2026 23:30:52 +0000
Subject: [PATCH 12/12] ggml-cpu: empty-expert single-thread path off by
 default (OMP_WAIT_POLICY=ACTIVE is what helps), trigger counter under
 GGML_MMID_STATS

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 ggml/src/ggml-cpu/ggml-cpu.cpp | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cpu/ggml-cpu.cpp b/ggml/src/ggml-cpu/ggml-cpu.cpp
index 4b3a8d5aa..2fbdd3892 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.cpp
+++ b/ggml/src/ggml-cpu/ggml-cpu.cpp
@@ -173,7 +173,7 @@ static bool ggml_backend_cpu_graph_is_empty_mmid(const struct ggml_cgraph * cgra
     static int enabled = -1;
     if (enabled < 0) {
         const char * e = getenv("GGML_CPU_EMPTY_MMID_SINGLE");
-        enabled = e ? (atoi(e) != 0) : 1;
+        enabled = e ? (atoi(e) != 0) : 0; // off by default: with spinning OpenMP workers it does not pay
     }
     if (!enabled) {
         return false;
@@ -203,7 +203,18 @@ static bool ggml_backend_cpu_graph_is_empty_mmid(const struct ggml_cgraph * cgra
 static enum ggml_status ggml_backend_cpu_graph_compute(ggml_backend_t backend, struct ggml_cgraph * cgraph) {
     struct ggml_backend_cpu_context * cpu_ctx = (struct ggml_backend_cpu_context *)backend->context;
 
-    const int n_threads = ggml_backend_cpu_graph_is_empty_mmid(cgraph) ? 1 : cpu_ctx->n_threads;
+    const bool empty_mmid = ggml_backend_cpu_graph_is_empty_mmid(cgraph);
+    const int n_threads = empty_mmid ? 1 : cpu_ctx->n_threads;
+    {
+        static int64_t n_calls = 0, n_single = 0;
+        static const bool stats = getenv("GGML_MMID_STATS") != nullptr;
+        if (stats) {
+            n_calls++; n_single += empty_mmid;
+            if (n_calls % 630 == 0) {
+                fprintf(stderr, "cpu graph compute: %lld calls, %lld single-threaded (empty expert work)\n", (long long) n_calls, (long long) n_single);
+            }
+        }
+    }
 
     struct ggml_cplan cplan = ggml_graph_plan(cgraph, n_threads, cpu_ctx->threadpool);
 
-- 
