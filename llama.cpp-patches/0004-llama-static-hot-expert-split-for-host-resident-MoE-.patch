     return true;
 }
 
+// LLAMA_MOE_HOT_LIST=<csv of "layer,expert"> : gather those experts of host-resident MoE layers into GPU tensors
+// (see llama_moe_hot). The graph then runs the hot experts on the GPU and the CPU skips them.
+void llama_model_base::load_tensors_moe_hot(llama_model_loader & ml) {
+    const char * list_path = getenv("LLAMA_MOE_HOT_LIST");
+    if (list_path == nullptr || list_path[0] == '\0') {
+        return;
+    }
+    std::map<int, std::vector<int32_t>> hot_of_layer;
+    {
+        FILE * f = fopen(list_path, "r");
+        if (f == nullptr) {
+            throw std::runtime_error(format("LLAMA_MOE_HOT_LIST: cannot open %s", list_path));
+        }
+        char line[256];
+        while (fgets(line, sizeof(line), f)) {
+            int il = -1, e = -1;
+            if (sscanf(line, "%d,%d", &il, &e) == 2 && il >= 0 && e >= 0) {
+                hot_of_layer[il].push_back(e);
+            }
+        }
+        fclose(f);
+    }
+    const int n_layer = (int) hparams.n_layer();
+    const int64_t n_expert = hparams.n_expert;
+
+    // collect the layers that qualify: experts on a host buffer, a GPU device assigned to the layer
+    struct plan_t { int il; ggml_backend_buffer_type_t buft; std::vector<int32_t> experts; };
+    std::vector<plan_t> plans;
+    for (auto & [il, experts] : hot_of_layer) {
+        if (il >= n_layer || experts.empty()) {
+            continue;
+        }
+        const auto & layer = layers[il];
+        if (!layer.ffn_up_exps || !layer.ffn_gate_exps || !layer.ffn_down_exps || layer.ffn_gate_up_exps) {
+            LLAMA_LOG_WARN("%s: layer %d: no separate up/gate/down expert tensors, skipped\n", __func__, il);
+            continue;
+        }
+        // the experts must live in host memory (CPU, CPU_REPACK or a pinned host buffer such as CUDA_Host)
+        ggml_backend_buffer_type_t host_buft = ggml_backend_buffer_get_type(layer.ffn_up_exps->buffer);
+        ggml_backend_dev_t host_dev = ggml_backend_buft_get_device(host_buft);
+        const bool on_host = ggml_backend_buft_is_host(host_buft) ||
+            (host_dev && ggml_backend_dev_type(host_dev) == GGML_BACKEND_DEVICE_TYPE_CPU);
+        if (!on_host) {
+            LLAMA_LOG_WARN("%s: layer %d: experts already on %s, skipped\n", __func__, il, ggml_backend_buft_name(host_buft));
+            continue;
+        }
+        ggml_backend_dev_t dev = pimpl->dev_layer.at(il).dev;
+        if (dev == nullptr || ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+            LLAMA_LOG_WARN("%s: layer %d: no GPU device assigned to the layer, skipped\n", __func__, il);
+            continue;
+        }
+        std::sort(experts.begin(), experts.end());
+        experts.erase(std::unique(experts.begin(), experts.end()), experts.end());
+        for (int32_t e : experts) {
+            if (e >= n_expert) {
+                throw std::runtime_error(format("LLAMA_MOE_HOT_LIST: expert %d out of range in layer %d", e, il));
+            }
+        }
+        plans.push_back({ il, ggml_backend_dev_buffer_type(dev), std::move(experts) });
+    }
+    if (plans.empty()) {
+        LLAMA_LOG_WARN("%s: no layer qualifies for the hot-expert split (%zu layers listed in %s)\n", __func__, hot_of_layer.size(), list_path);
+        return;
+    }
+
+    ggml_init_params params = {
+        /*.mem_size   =*/ ggml_tensor_overhead() * plans.size() * 7,
+        /*.mem_buffer =*/ NULL,
+        /*.no_alloc   =*/ true,
+    };
+    moe_hot.ctx.reset(ggml_init(params));
+    moe_hot.layers.assign(n_layer, llama_moe_hot_layer());
+
+    ggml_context * ctx = moe_hot.ctx.get();
+    for (const auto & pl : plans) {
+        const auto & layer = layers[pl.il];
+        auto & h = moe_hot.layers[pl.il];
+        h.n_hot = (int32_t) pl.experts.size();
+        auto mk = [&](ggml_tensor * src, const char * suffix) {
+            ggml_tensor * t = ggml_new_tensor_3d(ctx, src->type, src->ne[0], src->ne[1], h.n_hot);
+            ggml_format_name(t, "%s.hot%s", ggml_get_name(src), suffix);
+            return t;
+        };
+        h.up   = mk(layer.ffn_up_exps,   "");
+        h.gate = mk(layer.ffn_gate_exps, "");
+        h.down = mk(layer.ffn_down_exps, "");
+        h.hot_idx  = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, n_expert);
+        h.cold_idx = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, n_expert);
+        h.mask     = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1, n_expert);
+        h.cold_mask = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1, n_expert);
+        ggml_format_name(h.cold_mask, "blk.%d.moe_cold_mask", pl.il);
+        ggml_format_name(h.hot_idx,  "blk.%d.moe_hot_idx",  pl.il);
+        ggml_format_name(h.cold_idx, "blk.%d.moe_cold_idx", pl.il);
+        ggml_format_name(h.mask,     "blk.%d.moe_hot_mask", pl.il);
+    }
+    // one device for now (all qualifying layers share the first plan's buffer type)
+    moe_hot.buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(ctx, plans[0].buft));
+    if (!moe_hot.buf) {
+        throw std::runtime_error("hot-expert split: failed to allocate the GPU buffer");
+    }
+    ggml_backend_buffer_set_usage(moe_hot.buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    size_t n_bytes = 0;
+    std::vector<no_init<uint8_t>> staging;
+    for (const auto & pl : plans) {
+        const auto & layer = layers[pl.il];
+        auto & h = moe_hot.layers[pl.il];
+        for (auto [src, dst] : { std::make_pair(layer.ffn_up_exps, h.up), std::make_pair(layer.ffn_gate_exps, h.gate), std::make_pair(layer.ffn_down_exps, h.down) }) {
+            const auto * w = ml.get_weight(ggml_get_name(src));
+            if (w == nullptr) {
+                throw std::runtime_error(format("hot-expert split: weight %s not found", ggml_get_name(src)));
+            }
+            const auto & file = ml.files.at(w->idx);
+            const size_t expert_bytes = src->nb[2];
+            staging.resize(expert_bytes);
+            for (int32_t slot = 0; slot < h.n_hot; ++slot) {
+                const int32_t e = pl.experts[slot];
+                file->seek(w->offs + (size_t) e * expert_bytes, SEEK_SET);
+                file->read_raw(staging.data(), expert_bytes);
+                ggml_backend_tensor_set(dst, staging.data(), (size_t) slot * dst->nb[2], expert_bytes);
+                n_bytes += expert_bytes;
+            }
+        }
+        std::vector<int32_t> hot_idx(n_expert, 0), cold_idx(n_expert);
+        std::vector<float>   mask(n_expert, 0.0f), cold_mask(n_expert, 1.0f);
+        for (int64_t e = 0; e < n_expert; ++e) {
+            cold_idx[e] = (int32_t) e;
+        }
+        for (int32_t slot = 0; slot < h.n_hot; ++slot) {
+            const int32_t e = pl.experts[slot];
+            hot_idx[e]   = slot;
+            cold_idx[e]  = 0;    // a dummy: ids must stay valid for the GPU large-batch path, the row is masked out
+            mask[e]      = 1.0f;
+            cold_mask[e] = 0.0f;
+        }
+        ggml_backend_tensor_set(h.cold_mask, cold_mask.data(), 0, cold_mask.size() * sizeof(float));
+        ggml_backend_tensor_set(h.hot_idx,  hot_idx.data(),  0, hot_idx.size()  * sizeof(int32_t));
+        ggml_backend_tensor_set(h.cold_idx, cold_idx.data(), 0, cold_idx.size() * sizeof(int32_t));
+        ggml_backend_tensor_set(h.mask,     mask.data(),     0, mask.size()     * sizeof(float));
+        LLAMA_LOG_INFO("%s: layer %3d: %d hot experts on %s\n", __func__, pl.il, h.n_hot, ggml_backend_buft_name(pl.buft));
+    }
+    LLAMA_LOG_INFO("%s: %zu layers, %.2f GiB of hot experts uploaded\n", __func__, plans.size(), n_bytes / 1024.0 / 1024.0 / 1024.0);
+}
